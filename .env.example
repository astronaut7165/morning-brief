# 로컬 실행용 예시입니다. 복사해서 .env 로 저장한 뒤 값을 채우세요 (.env 는 git에 올라가지 않습니다).
# GitHub Actions 에서는 같은 이름으로 Secrets(키·웹훅) / Variables(LLM_*) 에 등록합니다.

# ── LLM ─────────────────────────────────────────────
# claude-code | anthropic | openai | gemini
#   claude-code: 로컬 Claude Code CLI 를 구독 로그인으로 사용 (API 키 불필요)
#   비워 두면 API 키가 있으면 그 provider, 없으면 claude-code 로 자동 선택
LLM_PROVIDER=
# 비워 두면 provider 기본값 (claude-code: opus / anthropic: claude-opus-5-5 / openai: gpt-5-mini / gemini: gemini-2.5-flash)
LLM_MODEL=
# claude-code·anthropic 추론 강도: low | medium | high (기본 medium)
LLM_EFFORT=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── 메신저 (하나 이상) ──────────────────────────────
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
