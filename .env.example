# 로컬 실행용 예시입니다. 복사해서 .env 로 저장한 뒤 값을 채우세요 (.env 는 git에 올라가지 않습니다).
# GitHub Actions 에서는 같은 이름으로 Secrets(키·웹훅) / Variables(LLM_*) 에 등록합니다.

# ── LLM ─────────────────────────────────────────────
# anthropic | openai | gemini — 비워 두면 아래에 채워진 API 키로 자동 선택
LLM_PROVIDER=
# 비워 두면 provider 기본값 (anthropic: claude-opus-5-5 / openai: gpt-5-mini / gemini: gemini-2.5-flash)
LLM_MODEL=
# anthropic 전용 추론 강도: low | medium | high (기본 medium)
LLM_EFFORT=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── 메신저 (하나 이상) ──────────────────────────────
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
